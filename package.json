{
  "name": "thinking-forks-m0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run verify:assets && tsc --noEmit && vite build && node scripts/prune-build.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "fetch:assets": "node scripts/fetch-assets.mjs",
    "test:ai": "node scripts/evaluate-holdout.mjs --smoke",
    "test:holdout": "node scripts/evaluate-holdout.mjs",
    "test:pages": "node scripts/check-pages.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "~7.1.0"
  }
}
