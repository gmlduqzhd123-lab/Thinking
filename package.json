{
  "name": "thinking-forks-m0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run verify:assets && tsc --noEmit && vite build && node scripts/prune-build.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:lesson": "node scripts/lesson-check.mjs",
    "test:lesson-ai": "node scripts/lesson-ai-check.mjs",
    "fetch:assets": "node scripts/fetch-assets.mjs",
    "test:ai": "node scripts/evaluate-holdout.mjs --smoke",
    "test:performance": "node scripts/measure-performance.mjs",
    "test:holdout": "node scripts/evaluate-holdout.mjs",
    "test:pages": "node scripts/check-pages.mjs",
    "test:e2e": "node scripts/e2e-features.mjs",
    "test:mobile": "node scripts/mobile-check.mjs",
    "test:all": "node scripts/run-all-checks.mjs",
    "test:lesson-share": "node scripts/lesson-share-check.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "playwright": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "~7.1.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
